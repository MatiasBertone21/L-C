# =============================================================================
# Configuración del Sistema L&C (Librería y Papelería)
# Copiá este archivo a `.env` y reemplazá los valores antes de levantar Docker:
#   Copy-Item .env.example .env
# =============================================================================

# --- Aplicación ---
APP_NAME="L&C Stock & POS API"
APP_VERSION="0.5.0"
ENVIRONMENT="development"

# --- Puertos expuestos en el host ---
BACKEND_PORT=8000
FRONTEND_PORT=5173
MONGO_PORT=27017

# --- MongoDB (Contenedor y acceso desde MongoDB Compass) ---
MONGO_INITDB_ROOT_USERNAME=lc_admin
MONGO_INITDB_ROOT_PASSWORD=change_me_local_dev_password
MONGO_DB_NAME=lc_inventory

# URI interna opcional (si se omite en Docker, docker-compose la construye con las variables de arriba)
# MONGO_URI=mongodb://lc_admin:change_me_local_dev_password@mongo:27017/lc_inventory?authSource=admin

# --- Seguridad Backend (JWT & API Key opcional para scripts server-to-server) ---
JWT_SECRET_KEY=change_me_with_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
INTERNAL_API_KEY=change_me_optional_internal_api_key

# --- Usuarios iniciales para scripts/seed.py (entorno de desarrollo) ---
SEED_ADMIN_EMAIL=admin@librerialc.com.ar
SEED_ADMIN_PASSWORD=change_me_admin_dev_password
SEED_USER_EMAIL=ventas@librerialc.com.ar
SEED_USER_PASSWORD=change_me_user_dev_password

# --- CORS y Frontend ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000
VITE_USE_POLLING=true

# --- Módulo Catálogo de Proveedor e Importación Diaria ---
SUPPLIER_DEFAULT_CODE=elonce
SUPPLIER_IMAGE_ALLOWED_HOSTS=www.eloncemayorista.com.ar,eloncemayorista.com.ar
BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires
IMPORT_MAX_UPLOAD_MB=15
IMPORT_MIN_ROWS_RATIO=0.5
IMPORT_TMP_RETENTION_DAYS=7
